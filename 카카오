#index.html 파일의 <head> 태그 안, 다른 <script> 태그들이 있는 곳에 아래 코드를 넣으세요. 복사하신 키를 appkey= 바로 뒤에 붙여넣기
<script type="text/javascript" src="//dapi.kakao.com/v2/maps/sdk.js?appkey=80c2072c7eef6c807392e3589839b68d"></script>

#Explore Spots 섹션에서 지도를 불러오는 중...이라고 적힌 박스 부분을 아래 코드로 완전히 교체
<div class="glass-card" style="padding: 0; position: relative; height: 250px; overflow: hidden; margin-bottom: 24px;">
    <div id="map" style="width:100%; height:100%;"></div>
</div>

#파일 맨 밑의 </body> 바로 위에 있는 <script> 태그 안에 다음 코드를 추가
// 지도를 띄우는 함수
function initMap() {
    var container = document.getElementById('map');
    var options = {
        center: new kakao.maps.LatLng(36.6424, 127.4890), // 청주 시청 중심 좌표
        level: 3 // 확대 레벨
    };

    var map = new kakao.maps.Map(container, options);

    // 현재 위치에 마커 하나 꽂기
    var markerPosition  = new kakao.maps.LatLng(36.6424, 127.4890); 
    var marker = new kakao.maps.Marker({
        position: markerPosition
    });
    marker.setMap(map);
}

// 탐색 탭을 눌렀을 때 지도가 잘 보이도록 설정
const exploreTab = document.querySelector('[onclick*="explore"]');
exploreTab.addEventListener('click', () => {
    setTimeout(() => {
        initMap();
    }, 100);
});
